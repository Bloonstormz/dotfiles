spawn-at-startup "swayosd-server"

binds {
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "~/.config/bin/swayosd" "--output-volume" "+2"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "~/.config/bin/swayosd" "--output-volume" "-2"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title="Mute playback" { spawn "~/.config/bin/swayosd" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title="Mute microphone"{ spawn "~/.config/bin/swayosd" "--input-volume" "mute-toggle"; }

    XF86AudioPlay       allow-when-locked=true hotkey-overlay-title="Play / pause track" { spawn "~/.config/bin/swayosd" "--playerctl" "play-pause"; }
    XF86AudioStop       allow-when-locked=true hotkey-overlay-title="Stop track" { spawn "~/.config/bin/swayosd" "--playerctl" "stop"; } 
    XF86AudioPrev       allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "~/.config/bin/swayosd" "--playerctl" "prev"; }
    XF86AudioNext       allow-when-locked=true hotkey-overlay-title="Next track" { spawn "~/.config/bin/swayosd" "--playerctl" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Increase brightness" { spawn "~/.config/bin/swayosd" "brightness" "+5"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" { spawn "~/.config/bin/swayosd" "brightness" "-5"; }
}
