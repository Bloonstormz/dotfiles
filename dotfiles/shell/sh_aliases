#!/bin/bash
# shellcheck disable=SC1090,SC3043,SC1091

# perl to remove any trailing new line
# Convert to base 64 for OSC 52 to copy to clipboard. Works over ssh
alias copy='perl -pe "chomp if eof" | base64 -w 0 | xargs printf "\033]52;c;%s\a"'

# shellcheck disable=SC2142
alias gitpb="git branch -vv | awk '\$3 \$4 ~ /:gone]$/ { print \$1 }' | xargs -n 1 git branch -D" # Remove branches that have been deleted on upstream
alias sd='loginctl poweroff || shutdown -P 0'
alias rb='loginctl reboot || shutdown -r 0'
alias g='git'
alias gl='git log --oneline'
alias gc='git checkout'
alias gitl='gl'
alias lg='lazygit'

# git reword reuse
alias grr='git commit --amend --edit -F .git/COMMIT_EDITMSG'
alias gitrr='grr'

# git reword
alias gr='git commit --amend'
alias gitr='gr'

{ command -v gf && { unalias gf || unset gf; }; } >/dev/null 2>&1
alias gf='git fetch --all'

alias rg='\rg -M 250'

# Sudo with PATH set to running user's PATH
# TODO: Consider an alias which also sets XDG_* variables to reuse user configs?
alias sudop='sudo env PATH="$PATH"'

alias dirsize='ls -A | xargs du -hs | sort -h'

man() {
    local width=${MANWIDTH:-$((COLUMNS - 4))}
    if command man -O width=$COLUMNS man &>/dev/null; then
        command man -O "width=$width" "$@"
    else
        MANWIDTH=$width command man "$@"
    fi
}

if [ -n "$ZSH_VERSION" ]; then
    _CUR_SHELL="zsh"
elif [ -n "$BASH_VERSION" ]; then
    _CUR_SHELL="bash"
else
    _CUR_SHELL="sh"
fi
_command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# C define search
rgd() {
    local search_term="$1"
    shift
    rg "#define\s+$search_term" "$@"
}

re_source() {
    . "$HOME/.${_CUR_SHELL}rc"
}

if _command_exists pay-respects; then
    eval "$(pay-respects "${_CUR_SHELL}" --alias)"
    export _PR_PACKAGE_MANAGER="" # Don't search for command via package manager
    if [ "$_CUR_SHELL" = "zsh" ]; then
        # Workaround for p10k integration causing a "__pr_base:1: bad substitution"
        # Not needed after a pay-respects has a release >0.8.8
        __pr_base() {
            _PR_MODE="$1" _PR_PREFIX="> " _PR_LAST_COMMAND="$2" _PR_ALIAS="$(alias)" _PR_SHELL="zsh" "pay-respects"
        }
    fi
fi
if _command_exists yazi; then
    yz() {
        local tmp cwd
        tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
        command yazi "$@" --cwd-file="$tmp"
        IFS= read -r -d '' cwd <"$tmp"
        [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
        command rm -f -- "$tmp"
    }
fi
if _command_exists fzf; then
    eval "$(command fzf --"${_CUR_SHELL}")"
    fzf() {
        local lines=()
        if ! [[ -t 0 ]]; then
            while read -r line; do
                lines+=("$line")
            done
        fi
        local sub_cmd=()
        local main_cmd=()
        while [[ $# -gt 0 ]]; do
            arg="$1"
            shift

            case "$arg" in
            --)
                main_cmd+=("$@")
                break
                ;;
            -*)
                sub_cmd+=("$arg")
                ;;
            *)
                main_cmd=("$arg" "$@")
                break
                ;;
            esac
        done

        if [[ ${#main_cmd[@]} -eq 0 ]]; then
            if [[ "${#lines[@]}" -gt 0 ]]; then
                printf "%s\n" "${lines[@]}" | command fzf "${sub_cmd[@]}"
            else
                command fzf "${sub_cmd[@]}" --bind "alt-i:reload($FZF_DEFAULT_COMMAND -I)"
            fi
        else
            local input
            if [[ "${#lines[@]}" -gt 0 ]]; then
                input="$(printf "%s\n" "${lines[@]}" | command fzf "${sub_cmd[@]}")" || return
            else
                input="$(command fzf "${sub_cmd[@]}" --bind "alt-i:reload($FZF_DEFAULT_COMMAND -I)")" || return
            fi
            "${main_cmd[@]}" "$input"
        fi
    }
fi

[ -e "$HOME/.config/.local_aliases" ] && . "$HOME/.config/.local_aliases"
unset _CUR_SHELL
unset -f _command_exists
