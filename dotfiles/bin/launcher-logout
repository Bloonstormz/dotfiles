#!/usr/bin/env bash

# Adapted from https://github.com/cebem1nt/dotfiles/blob/main/.config/rofi/bin/logout

set -x
if [[ "$#" -lt 1 ]]; then
	LAUNCHER="$("$HOME/.config/bin/get_launcher")"
else
	LAUNCHER="$1"
	shift
fi

# Options
SHUTDOWN=''
REBOOT=''
LOCK=''
SUSPEND='󰤄'
LOGOUT='󰗽'

YES=''
NO=''

launcher() {
	if [[ "$LAUNCHER" == "rofi" ]]; then
		"$1"_rofi
	else
		"$1"_wofi
	fi
}

picker_rofi() {
	rofi -dmenu -sync -theme "$HOME/.config/rofi/themes/logout.rasi"
}
picker_wofi() {
	wofi --dmenu
}

# Confirmation CMD
confirm_rofi() {
	rofi -theme-str 'window {location: center; anchor: center; fullscreen: false; width: 350px;}' \
		-theme-str 'mainbox {children: [ "message", "listview" ];}' \
		-theme-str 'listview {columns: 2; lines: 1;}' \
		-theme-str 'element-text {horizontal-align: 0.5;}' \
		-theme-str 'textbox {horizontal-align: 0.5;}' \
		-mesg 'Are you Sure?' \
		-p 'Confirmation' \
		-theme "$HOME/.config/rofi/themes/logout.rasi" \
		-dmenu \
		-sync
}
confirm_wofi() {
	wofi --dmenu
}

# Ask for confirmation
confirm_exit() {
	echo -e "$YES\n$NO" | launcher "confirm"
}

# Pass variables to launcher dmenu
run_launcher() {
	echo -e "$LOCK\n$SUSPEND\n$LOGOUT\n$REBOOT\n$SHUTDOWN" | launcher "picker"
}

# Execute Command
run_cmd() {
	selected="$(confirm_exit)"
	if [[ "$selected" == "$YES" ]]; then
		if [[ $1 == '--shutdown' ]]; then
			loginctl poweroff || shutdown -P 0
		elif [[ $1 == '--reboot' ]]; then
			loginctl reboot || shutdown -r 0
		elif [[ $1 == '--suspend' ]]; then
			loginctl suspend || systemctl suspend
			systemctl suspend
		elif [[ $1 == '--logout' ]]; then
			if [[ "$DESKTOP_SESSION" == 'openbox' ]]; then
				openbox --exit
			elif [[ "$DESKTOP_SESSION" == 'bspwm' ]]; then
				bspc quit
			elif [[ "$DESKTOP_SESSION" == 'i3' ]]; then
				i3-msg exit
			elif [[ "$DESKTOP_SESSION" == 'plasma' ]]; then
				qdbus org.kde.ksmserver /KSMServer logout 0 0 0
			elif [[ "$MANGO_INSTANCE_SIGNATURE" ]]; then
				mmsg dispatch quit
			elif [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
				pkill gammastep
				hyprctl dispatch 'hl.dsp.exit()'
			elif [[ -n "$NIRI_SOCKET" ]]; then
				niri msg action quit -s
			else
				exit 1
			fi
		fi
	else
		exit 0
	fi
}

# Actions
if [[ $# -ne 0 ]]; then
	run_cmd $1
else
	choice="$(run_launcher)"
	case ${choice} in
	$SHUTDOWN)
		run_cmd --shutdown
		;;
	$REBOOT)
		run_cmd --reboot
		;;
	$LOCK)
		sleep 0.1 # Make rofi menu dissapear
		loginctl lock-session
		;;
	$SUSPEND)
		run_cmd --suspend
		;;
	$LOGOUT)
		run_cmd --logout
		;;
	esac
fi
