#!/usr/bin/env bash

sway_dismiss() {
	swaync-client --close-latest
}
sway_dismiss_all() {
	swaync-client --close-all
}
sway_view() {
	swaync-client --toggle-panel
}

create_notif() {
	type="$1"
	app_name="$2"
	shift 2
	case "$type" in
	error)
		icon="dialog-error"
		msg=("$@")
		;;
	info)
		icon="dialog-information"
		msg=("$@")
		;;
	test)
		if command -v "$1" &>/dev/null; then
			exit 0
		fi
		icon="dialog-error"
		msg="Missing $1!"
		;;
	esac
	notify-send --icon "$icon" \
		--app-name "$app_name" \
		"$msg"
}

case "${1:-dismiss}" in
"dismiss")
	sway_dismiss
	;;
"dismiss-all")
	sway_dismiss_all
	;;
"view")
	sway_view
	;;
*)
	create_notif "$@"
	;;
esac
