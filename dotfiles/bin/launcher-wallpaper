#!/usr/bin/env bash

if ! [[ -d "$HOME/.config/Wallpapers" ]]; then
	exit 1
fi
if ! command -v awww &>/dev/null; then
	exit 1
fi

launcher="$("$HOME/.config/bin/get_launcher")"

mapfile -t WALLPAPER_PATHS < <(
	find -L "$(realpath "$HOME/.config/Wallpapers")" -mindepth 1 -maxdepth 1 -type f | sort
)
if [[ "${#WALLPAPER_PATHS[@]}" -eq 0 || -z "${#WALLPAPER_PATHS[0]}" ]]; then
	exit 1
fi

format_dmenu() {
	local image_first=false
	if [[ "$#" -ne 1 ]] && [[ "$2" == "-i" ]]; then
		image_first=true
	fi
	for i in "${!WALLPAPER_THUMBNAILS[@]}"; do
		if [[ "$image_first" == true ]]; then
			printf "$1\n" "${WALLPAPER_THUMBNAILS[i]}" "${WALLPAPER_PATHS[i]}"
		else
			printf "$1\n" "${WALLPAPER_PATHS[i]}" "${WALLPAPER_THUMBNAILS[i]}"
		fi
	done
}

rofi_cmd() {
	rofi -dmenu -sync -theme "$HOME/.config/rofi/themes/wallpapers.rasi"
}
wofi_cmd() {
	wofi --dmenu
}
launcher_cmd() {
	"$launcher"_cmd
}

picker_rofi() {
	if [[ "${#WALLPAPER_THUMBNAILS[@]}" -eq 0 ]]; then
		printf "%s\n" "${WALLPAPER_PATHS[@]}" | rofi_cmd
	else
		format_dmenu "%s\x00icon\x1f%s" | rofi_cmd
	fi
}
picker_wofi() {
	if [[ "${#WALLPAPER_THUMBNAILS[@]}" -eq 0 ]]; then
		printf "%s\n" "${WALLPAPER_PATHS[@]}" | wofi_cmd
	else
		format_dmenu "img:%s:text:%s" -i | wofi_cmd
	fi
}

pick_wallpaper() {
	picker_"$launcher"
}

case "${1:-pick}" in
set)
	awww img "$2"
	;;
cycle)
	if ! command -v jaq &>/dev/null; then
		~/.config/bin/notification error "$0" "Missing jaq binary"
		exit 1
	fi
	mapfile -t cur_status < <(awww query -j | jaq -r '.""[] | .name,.displaying.image')

	idx=0
	while [[ "$idx" -lt "${#cur_status[@]}" ]]; do
		display="${cur_status[$idx]}"
		img="${cur_status[$((idx + 1))]}"

		next=unset
		for file in "${WALLPAPER_PATHS[@]}"; do
			if [[ "$next" == true ]]; then
				awww img "$file" -o "$display"
				break
			fi
			realpath $file
			if [[ "$cur_image" == "$(realpath "$file")" ]]; then
				next=true
			fi
		done
		if [[ "$next" == unset ]]; then
			awww img "${WALLPAPER_PATHS[0]}" -o "$display"
		fi

		idx=$((idx + 2))
	done

	;;
pick)
	WALLPAPER_THUMBNAILS=()
	if command -v "ffmpeg" &>/dev/null; then
		thumbnail_dir="$HOME/.cache/Wallpapers/thumbnails"
		mkdir -p -- "$thumbnail_dir"
		for wallpaper in "${WALLPAPER_PATHS[@]}"; do
			path="$thumbnail_dir/$(basename "$wallpaper").jpg"
			if ! [[ -e "$path" ]]; then
				ffmpeg -i "$wallpaper" "-vf" "scale='if(gt(iw,ih),500,-1)':'if(gt(iw,ih),-1,500)'" \
					-frames:v 1 -q:v 5 -update 1 "$path"
			fi
			WALLPAPER_THUMBNAILS+=(
				"$path"
			)
		done
	fi

	chosen="$(pick_wallpaper)"
	if [[ -n "$chosen" ]]; then
		if [[ -n "$NIRI_SOCKET" ]]; then
			mapfile -t monitors < <(niri msg -j outputs | jaq -r '.[] | "\(.name) - \(.make) \(.model)"')
		else
			mapfile -t monitors < <(awww query -j | jaq -r '.""[].name')
		fi
		if [[ "${#monitors[@]}" -gt 1 ]]; then
			target="$({
				printf "%s\n" "${monitors[@]}"
				echo "All"
			} | launcher_cmd)"

			if [[ "$target" == All ]]; then
				awww img "$chosen"
			else
				awww img "$chosen" -o "${target%% *}"
			fi
		else
			awww img "$chosen"
		fi
	fi
	;;
esac
