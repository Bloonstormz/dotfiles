#!/bin/sh

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return 1 ;;
esac

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

export EDITOR="nvim"
export MANPAGER="nvim +Man!"
export MANWIDTH="999"
# man pre-formats the man page using groff causing hard-wraps making the
# man page display incorrectly if the window size changes

PATH="$HOME/.cargo/bin/:$HOME/bin/:$HOME/scripts/:$PATH"

if [ -e "$HOME/.config/.sh_aliases" ]; then
	. "$HOME/.config/.sh_aliases"
fi

[ -e "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
true
